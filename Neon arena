#  Geschosse, Items, Kollisionen
# ---------------------------------------------------------------
def kugelnUpdate(dt):
    for k in S.kugeln:
        k[0] += k[2] * dt
        k[1] += k[3] * dt
        k[4] -= dt
    S.kugeln = [k for k in S.kugeln if k[4] > 0 and 0 < k[0] < W and 0 < k[1] < H]
    for k in S.feindkugeln:
        k[0] += k[2] * dt
        k[1] += k[3] * dt
        k[4] -= dt
    S.feindkugeln = [k for k in S.feindkugeln
                     if k[4] > 0 and -30 < k[0] < W + 30 and -30 < k[1] < H + 30]


def kollisionen(dt):
    sp = S.spieler
    # Spielerkugeln gegen Feinde
    for f in S.feinde:
        if f.tot:
            continue
        rr = f.r + 5
        for k in S.kugeln:
            if k[4] <= 0:
                continue
            dx = k[0] - f.x
            dy = k[1] - f.y
            if dx * dx + dy * dy < rr * rr:
                k[4] = 0
                treffer(f, 1, k[2], k[3])
                if f.tot:
                    break
    S.kugeln = [k for k in S.kugeln if k[4] > 0]

    # Feinde gegen Spieler
    for f in S.feinde:
        if f.tot:
            continue
        dx = f.x - sp.x
        dy = f.y - sp.y
        rr = f.r + 9
        if dx * dx + dy * dy < rr * rr:
            if sp.dash > 0:
                if f.hp <= 1 and f.typ != "boss":
                    toeten(f)
            else:
                spielerTreffer()
                if S.zustand != "spiel":
                    return

    # Feindkugeln gegen Spieler
    if sp.unverw <= 0 and sp.dash <= 0:
        for k in S.feindkugeln:
            dx = k[0] - sp.x
            dy = k[1] - sp.y
            if dx * dx + dy * dy < 14 * 14:
                k[4] = 0
                spielerTreffer()
                break

    # Items
    uebrig = []
    for it in S.items:
        it[3] += dt
        it[4] -= dt
        dx = sp.x - it[0]
        dy = sp.y - it[1]
        d = sqrt(dx * dx + dy * dy) + 0.001
        if d < 100:
            it[0] += dx / d * 280.0 * dt
            it[1] += dy / d * 280.0 * dt
        if d < 24:
            einsammeln(it)
        elif it[4] > 0:
            uebrig.append(it)
    S.items = uebrig


def effekteUpdate(dt):
    drag = max(0.0, 1.0 - 2.5 * dt)
    neu = []
    for p in S.partikel:
        p[4] -= dt
        if p[4] > 0:
            p[0] += p[2] * dt
            p[1] += p[3] * dt
            p[2] *= drag
            p[3] *= drag
            neu.append(p)
    S.partikel = neu
    neu = []
    for r in S.ringe:
        r[3] -= dt
        if r[3] > 0:
            neu.append(r)
    S.ringe = neu
    neu = []
    for t in S.texte:
        t[3] -= dt
        t[1] -= 40.0 * dt
        if t[3] > 0:
            neu.append(t)
    S.texte = neu
    S.shake = max(0.0, S.shake - 45.0 * dt)
    if S.shake > 0:
        S.ox = uniform(-1.0, 1.0) * S.shake
        S.oy = uniform(-1.0, 1.0) * S.shake
    else:
        S.ox = 0.0
        S.oy = 0.0
    S.blitz = max(0.0, S.blitz - dt * 2.5)
    S.puls = max(0.0, S.puls - dt * 2.0)
    if S.bannerzeit > 0:
        S.bannerzeit -= dt


def sterneUpdate(dt):
    for s in S.sterne:
        s[0] -= s[2] * dt
        if s[0] < 0:
            s[0] = W
            s[1] = uniform(0, H)


def wellenUpdate(dt):
    fertig = []
    rest = []
    for m in S.marker:
        m[3] -= dt
        if m[3] <= 0:
            fertig.append(m)
        else:
            rest.append(m)
    S.marker = rest
    for m in fertig:
        f = Feind(m[2], m[0], m[1])
        S.feinde.append(f)
        funken(m[0], m[1], f.farbe, 14, 160, 0.4)
        ring(m[0], m[1], 50, f.farbe, 0.3)
        if m[2] == "boss":
            shake(8)
            ring(m[0], m[1], 300, WEISS, 0.6)

    if S.pause_zw > 0:
        S.pause_zw -= dt
        if S.pause_zw <= 0:
            starteWelle()
        return

    S.spawnzeit -= dt
    if len(S.spawnliste) > 0 and S.spawnzeit <= 0 and len(S.feinde) + len(S.marker) < 38:
        typ = S.spawnliste.pop(0)
        if typ == "boss":
            x = W / 2.0
            y = 150.0
            dauer = 1.8
        else:
            x, y = spawnPunkt(240)
            dauer = 0.9
        S.marker.append([x, y, typ, dauer, dauer])
        S.spawnzeit = max(0.22, 0.9 - 0.025 * S.welle)

    if len(S.spawnliste) == 0 and len(S.marker) == 0 and len(S.feinde) == 0:
        welleGeschafft()


def aktualisiere(rdt):
    dt = rdt
    if S.slow > 0:
        S.slow -= rdt
        dt = rdt * 0.3
    spielerUpdate(dt)
    for f in S.feinde:
        if not f.tot:
            feindUpdate(f, dt)
    kugelnUpdate(dt)
    kollisionen(dt)
    if S.zustand != "spiel":
        return
    S.feinde = [f for f in S.feinde if not f.tot] + S.neu
    S.neu = []
    if S.combozeit > 0:
        S.combozeit -= dt
        if S.combozeit <= 0:
            S.combo = 0
    wellenUpdate(dt)
    effekteUpdate(dt)


