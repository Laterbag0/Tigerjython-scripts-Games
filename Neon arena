def verarbeiteEreignisse():
    while len(EREIGNISSE) > 0:
        c = EREIGNISSE.pop(0)
        if S.zustand == "menu":
            if c == 32 or c == 10:
                neuesSpiel()
        elif S.zustand == "spiel":
            if c == 32:
                dashStart()
            elif c == 80 or c == 27:
                S.zustand = "pause"
        elif S.zustand == "pause":
            if c == 80 or c == 27 or c == 32 or c == 10:
                S.zustand = "spiel"
        elif S.zustand == "tot":
            if (c == 32 or c == 10 or c == 82) and S.totzeit > 1.2:
