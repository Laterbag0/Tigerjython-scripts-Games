from gamegrid import *
from java.awt import Color, Point, Font
from java.lang import System
from math import sin, cos, sqrt, atan2, pi
from random import random, uniform, randint, choice, shuffle

W = 800
H = 600
MAXLEBEN = 5

# typ: (Leben, Radius, Tempo, Farbe, Punkte, Ecken)
DATEN = {
    "chaser":   (1, 12, 120, (255, 70, 90), 10, 4),
    "shooter":  (3, 15, 85, (255, 60, 230), 30, 4),
    "splitter": (4, 17, 80, (255, 150, 40), 25, 6),
    "mini":     (1, 8, 165, (255, 200, 90), 5, 3),
    "tank":     (12, 27, 55, (80, 255, 130), 80, 8),
    "dart":     (1, 11, 70, (255, 240, 60), 20, 3),
    "boss":     (60, 44, 80, (255, 255, 255), 1000, 12)
}
KOSTEN = {"chaser": 1, "shooter": 3, "splitter": 3, "dart": 2, "tank": 6}

ITEMFARBE = {"T": (255, 225, 70), "R": (255, 130, 40), "S": (90, 150, 255),
             "N": (255, 255, 255), "H": (255, 90, 150)}
ITEMNAME = {"T": "TRIPLE", "R": "TURBO", "S": "SCHILD", "N": "NUKE", "H": "+1 LEBEN"}
ITEMZEICHEN = {"T": "T", "R": "R", "S": "S", "N": "N", "H": "+"}

GRIDFARBEN = [(40, 70, 170), (110, 50, 170), (170, 50, 110), (40, 140, 140), (150, 120, 40)]
CYAN = (60, 240, 255)
WEISS = (255, 255, 255)
REKORDDATEI = System.getProperty("user.home") + "/neon_arena_rekord.txt"


class Zustand(object):
    pass


S = Zustand()
S.ox = 0.0
S.oy = 0.0
S.zeit = 0.0
S.rekord = 0
S.sterne = []
for i in range(30):
    S.sterne.append([uniform(0, W), uniform(0, H), uniform(4, 22), uniform(40, 170)])

gehalten = {}
EREIGNISSE = []
FONTS = {}


# ---------------------------------------------------------------
#  Tastatur (mit Schutz gegen Linux-Tastenwiederholung)
# ---------------------------------------------------------------
def taste(e):
    c = e.getKeyCode()
    neu = c not in gehalten
    gehalten[c] = 0
    if neu:
        EREIGNISSE.append(c)


def los(e):
    gehalten[e.getKeyCode()] = System.currentTimeMillis()


def aufraeumen():
    jetzt = System.currentTimeMillis()
    for c in list(gehalten.keys()):
        t = gehalten.get(c, 0)
        if t != 0 and jetzt - t > 70:
            gehalten.pop(c, None)


def down(c):
    return c in gehalten


# ---------------------------------------------------------------
#  Kleine Helfer
# ---------------------------------------------------------------
def cl(v):
    if v < 0:
        return 0
    if v > 255:
        return 255
    return int(v)


def P(x, y):
    return Point(int(x + S.ox), int(y + S.oy))


def font(g):
    if g not in FONTS:
        FONTS[g] = Font("Monospaced", Font.BOLD, g)
    return FONTS[g]


def text(bg, s, x, y, groesse, col, a=255, mitte=False, welt=False):
    bg.setFont(font(groesse))
    bg.setPaintColor(Color(col[0], col[1], col[2], cl(a)))
    if mitte:
        x = x - len(s) * groesse * 0.6 / 2.0
    if welt:
        x = x + S.ox
        y = y + S.oy
    bg.drawText(s, Point(int(x), int(y)))


def vieleck(bg, x, y, n, r, rot, col, breite, a=255):
    bg.setLineWidth(breite)
    bg.setPaintColor(Color(col[0], col[1], col[2], cl(a)))
    pts = []
    for i in range(n):
        w = rot + 2.0 * pi * i / n
        pts.append(P(x + cos(w) * r, y + sin(w) * r))
    for i in range(n):
        bg.drawLine(pts[i], pts[(i + 1) % n])


def glut(bg, x, y, r, col, a):
    bg.setPaintColor(Color(col[0], col[1], col[2], cl(a)))
    bg.fillCircle(P(x, y), int(r))


def rekordLaden():
    try:
        f = open(REKORDDATEI, "r")
        s = f.read()
        f.close()
        return int(s.strip())
    except:
        return 0


def rekordSpeichern(v):
    try:
        f = open(REKORDDATEI, "w")
        f.write(str(v))
        f.close()
    except:
        pass


# ---------------------------------------------------------------
#  Effekte
# ---------------------------------------------------------------
def funken(x, y, col, anzahl, tempo, leben):
    for i in range(anzahl):
        if len(S.partikel) > 420:
            return
        w = uniform(0, 2.0 * pi)
        v = uniform(0.2, 1.0) * tempo
        S.partikel.append([x, y, cos(w) * v, sin(w) * v, uniform(0.3, 1.0) * leben, leben,
                           col[0], col[1], col[2]])


def ring(x, y, maxr, col, dauer):
    S.ringe.append([x, y, maxr, dauer, dauer, col])


def shake(v):
    S.shake = min(16.0, S.shake + v)


def popup(x, y, s, col):
    if len(S.texte) > 14:
        S.texte.pop(0)
    S.texte.append([x, y, s, 1.0, col])


def explosion(x, y, col, groesse):
    funken(x, y, col, int(8 + groesse * 0.9), 120 + groesse * 7, 0.7)
    funken(x, y, WEISS, int(3 + groesse * 0.2), 200, 0.35)
    ring(x, y, groesse * 2.6 + 20, col, 0.45)
    S.puls = min(1.0, S.puls + groesse * 0.012)


# ---------------------------------------------------------------
#  Spielfiguren
# ---------------------------------------------------------------
class Spieler(object):
    def __init__(self):
        self.x = W / 2.0
        self.y = H / 2.0 + 80.0
        self.vx = 0.0
        self.vy = 0.0
        self.leben = 3
        self.unverw = 1.5
        self.dash = 0.0
        self.dashcd = 0.0
        self.dashdx = 1.0
        self.dashdy = 0.0
        self.feuer = 0.0
        self.winkel = -pi / 2.0
        self.triple = 0.0
        self.rapid = 0.0
        self.schild = 0.0


class Feind(object):
    def __init__(self, typ, x, y):
        d = DATEN[typ]
        self.typ = typ
        self.x = x
        self.y = y
        self.vx = 0.0
        self.vy = 0.0
        self.hp = d[0]
        self.maxhp = d[0]
        self.r = d[1]
        self.speed = d[2] * min(1.5, 1.0 + 0.02 * S.welle)
        self.farbe = d[3]
        self.seiten = d[5]
        self.t = random() * 10.0
        self.zeit = uniform(0.5, 1.8)
        self.t2 = 3.0
        self.zustand = 0
        self.winkel = 0.0
        self.blitz = 0.0
        self.tot = False
        self.phase = 0
        if typ == "shooter":
            self.zustand = choice([-1, 1])
            self.t2 = uniform(2.0, 4.0)
        if typ == "boss":
            n = S.welle // 5
            self.hp = 60 + 40 * (n - 1)
            self.maxhp = self.hp
            self.speed = 80.0
            self.zeit = 2.0


# ---------------------------------------------------------------
#  Neues Spiel / Wellen
# ---------------------------------------------------------------
def neuesSpiel():
    S.zustand = "spiel"
    S.spieler = Spieler()
    S.kugeln = []
    S.feindkugeln = []
    S.feinde = []
    S.neu = []
    S.partikel = []
    S.ringe = []
    S.items = []
    S.marker = []
    S.texte = []
    S.punkte = 0
    S.combo = 0
    S.combozeit = 0.0
    S.welle = 0
    S.spawnliste = []
    S.spawnzeit = 0.0
    S.pause_zw = 1.3
    S.bannertext = "BEREIT?"
    S.bannerzeit = 1.3
    S.shake = 0.0
    S.blitz = 0.0
    S.slow = 0.0
    S.puls = 0.0
    S.totzeit = 0.0
    S.neuerrekord = False


def starteWelle():
    S.welle += 1
    n = S.welle
    liste = []
    if n % 5 == 0:
        liste.append("boss")
        for i in range(4 + (n // 5) * 2):
            liste.append("chaser")
        S.bannertext = "ACHTUNG - BOSS"
    else:
        budget = 3 + 3 * n
        pool = ["chaser", "chaser"]
        if n >= 2:
            pool.append("shooter")
        if n >= 3:
            pool.append("splitter")
            pool.append("dart")
        if n >= 4:
            pool.append("tank")
        if n >= 6:
            pool.append("dart")
            pool.append("shooter")
        while budget > 0:
            typ = choice(pool)
            c = KOSTEN[typ]
            if c > budget:
                typ = "chaser"
                c = 1
            liste.append(typ)
            budget -= c
        shuffle(liste)
        S.bannertext = "WELLE " + str(n)
    S.spawnliste = liste
    S.spawnzeit = 0.5
    S.bannerzeit = 2.2


def welleGeschafft():
    S.pause_zw = 2.6
    bonus = 100 * S.welle
    S.punkte += bonus
    popup(W / 2.0, H / 2.0 - 40, "WELLE GESCHAFFT +" + str(bonus), (120, 255, 160))
    S.bannertext = "WELLE GESCHAFFT"
    S.bannerzeit = 1.8
    if random() < 0.6:
        itemAbwerfen(uniform(150, W - 150), uniform(150, H - 150))


def spawnPunkt(mind):
    sp = S.spieler
    for i in range(30):
        x = uniform(50, W - 50)
        y = uniform(50, H - 50)
        dx = x - sp.x
        dy = y - sp.y
        if dx * dx + dy * dy > mind * mind:
            return x, y
    return uniform(50, W - 50), 50.0


def itemAbwerfen(x, y, typ=None):
    if typ is None:
        r = random()
        if r < 0.28:
            typ = "T"
        elif r < 0.55:
            typ = "R"
        elif r < 0.78:
            typ = "S"
        elif r < 0.90:
            typ = "N"
        else:
            typ = "H"
    if typ == "H" and S.spieler.leben >= MAXLEBEN:
        typ = "S"
    S.items.append([x, y, typ, 0.0, 12.0])


# ---------------------------------------------------------------
#  Treffer, Tod, Spezialeffekte
# ---------------------------------------------------------------
def feindschuss(x, y, w, v):
    if len(S.feindkugeln) > 260:
        return
    S.feindkugeln.append([x + cos(w) * 10, y + sin(w) * 10, cos(w) * v, sin(w) * v, 7.0])


def treffer(f, dmg, vx, vy):
    f.hp -= dmg
    f.blitz = 0.07
    funken(f.x, f.y, f.farbe, 4, 150, 0.35)
    if f.hp <= 0:
        toeten(f)
    elif f.typ != "boss":
        f.x += vx * 0.006
        f.y += vy * 0.006
    else:
        shake(0.4)


def toeten(f):
    if f.tot:
        return
    f.tot = True
    d = DATEN[f.typ]
    S.combo += 1
    S.combozeit = 2.4
    mult = min(10, 1 + S.combo // 5)
    pts = d[4] * mult
    S.punkte += pts
    popup(f.x, f.y - 10, str(pts), d[3])
    explosion(f.x, f.y, d[3], f.r)
    shake(f.r * 0.12)
    if f.typ == "splitter":
        for i in range(3):
            w = uniform(0, 2.0 * pi)
            m = Feind("mini", f.x + cos(w) * 10, f.y + sin(w) * 10)
            m.vx = cos(w) * 260
            m.vy = sin(w) * 260
            S.neu.append(m)
    chance = 0.06
    if f.typ == "tank":
        chance = 0.7
    elif f.typ == "splitter":
        chance = 0.12
    elif f.typ == "shooter":
        chance = 0.10
    elif f.typ == "mini":
        chance = 0.0
    elif f.typ == "boss":
        chance = 0.0
    if random() < chance:
        itemAbwerfen(f.x, f.y)
    if f.typ == "boss":
        bossBesiegt(f)


def bossBesiegt(f):
    S.slow = 1.0
    shake(16)
    S.blitz = 0.7
    S.feindkugeln = []
    cols = [(255, 90, 90), (255, 170, 50), (255, 60, 255), CYAN, WEISS]
    for i in range(5):
        ring(f.x, f.y, 120 + i * 70, cols[i], 0.6 + i * 0.12)
    funken(f.x, f.y, WEISS, 120, 520, 1.2)
    funken(f.x, f.y, (255, 120, 60), 100, 380, 1.0)
    S.spieler.leben = min(MAXLEBEN, S.spieler.leben + 1)
    popup(f.x, f.y - 50, "BOSS BESIEGT +1 LEBEN", (120, 255, 160))
    itemAbwerfen(f.x - 40, f.y, "H")
    itemAbwerfen(f.x + 40, f.y)
    for g in S.feinde:
        if g is not f and not g.tot:
            toeten(g)


def stossWelle(x, y, radius, col):
    ring(x, y, radius, col, 0.5)
    ring(x, y, radius * 0.6, WEISS, 0.35)
    for f in S.feinde:
        if f.tot or f.typ == "boss":
            continue
        dx = f.x - x
        dy = f.y - y
        d = sqrt(dx * dx + dy * dy) + 0.001
        if d < radius + f.r:
            if f.hp <= 1:
                toeten(f)
            else:
                f.x += dx / d * 70.0
                f.y += dy / d * 70.0


def spielerTreffer():
    sp = S.spieler
    if sp.unverw > 0 or sp.dash > 0:
        return
    if sp.schild > 0:
        sp.schild = 0.0
        sp.unverw = 1.2
        stossWelle(sp.x, sp.y, 170, (90, 150, 255))
        shake(6)
        return
    sp.leben -= 1
    sp.unverw = 2.0
    S.combo = 0
    S.combozeit = 0.0
    shake(14)
    S.blitz = 0.3
    S.feindkugeln = []
    stossWelle(sp.x, sp.y, 190, (255, 70, 90))
    explosion(sp.x, sp.y, CYAN, 22)
    if sp.leben <= 0:
        spielEnde()


def spielEnde():
    sp = S.spieler
    S.zustand = "tot"
    S.totzeit = 0.0
    explosion(sp.x, sp.y, CYAN, 46)
    funken(sp.x, sp.y, WEISS, 90, 450, 1.1)
    ring(sp.x, sp.y, 500, (255, 70, 90), 1.0)
    shake(16)
    S.blitz = 0.5
    if S.punkte > S.rekord:
        S.rekord = S.punkte
        S.neuerrekord = True
        rekordSpeichern(S.rekord)


def nuke():
    sp = S.spieler
    S.blitz = 0.9
    shake(16)
    S.feindkugeln = []
    ring(sp.x, sp.y, 950, WEISS, 0.9)
    ring(sp.x, sp.y, 650, (255, 200, 80), 0.7)
    ring(sp.x, sp.y, 400, (255, 90, 90), 0.5)
    for f in S.feinde:
        if f.tot:
            continue
        if f.typ == "boss":
            treffer(f, 15, 0, 0)
        else:
            toeten(f)


def einsammeln(it):
    sp = S.spieler
    t = it[2]
    col = ITEMFARBE[t]
    popup(sp.x, sp.y - 25, ITEMNAME[t], col)
    ring(sp.x, sp.y, 70, col, 0.4)
    funken(sp.x, sp.y, col, 14, 200, 0.5)
    if t == "T":
        sp.triple = 12.0
    elif t == "R":
        sp.rapid = 10.0
    elif t == "S":
        sp.schild = 12.0
    elif t == "N":
        nuke()
    elif t == "H":
        sp.leben = min(MAXLEBEN, sp.leben + 1)


# ---------------------------------------------------------------
#  Eingabe -> Bewegung
# ---------------------------------------------------------------
def bewegungsEingabe():
    ix = 0.0
    iy = 0.0
    if down(65):
        ix -= 1.0
    if down(68):
        ix += 1.0
    if down(87):
        iy -= 1.0
    if down(83):
        iy += 1.0
    il = sqrt(ix * ix + iy * iy)
    if il > 0:
        ix = ix / il
        iy = iy / il
    return ix, iy, il


def dashStart():
    sp = S.spieler
    if sp.dashcd > 0 or sp.dash > 0:
        return
    ix, iy, il = bewegungsEingabe()
    if il == 0:
        ix = cos(sp.winkel)
        iy = sin(sp.winkel)
    sp.dash = 0.17
    sp.dashcd = 1.1
    sp.dashdx = ix
    sp.dashdy = iy
    sp.unverw = max(sp.unverw, 0.3)
    ring(sp.x, sp.y, 60, CYAN, 0.3)
    funken(sp.x, sp.y, CYAN, 14, 260, 0.4)
    shake(2.5)


def spielerUpdate(dt):
    sp = S.spieler
    ix, iy, il = bewegungsEingabe()
    ax = 0.0
    ay = 0.0
    if down(37):
        ax -= 1.0
    if down(39):
        ax += 1.0
    if down(38):
        ay -= 1.0
    if down(40):
        ay += 1.0
    zielt = (ax != 0.0 or ay != 0.0)

    if sp.unverw > 0:
        sp.unverw -= dt
    if sp.dashcd > 0:
        sp.dashcd -= dt
    if sp.triple > 0:
        sp.triple -= dt
    if sp.rapid > 0:
        sp.rapid -= dt
    if sp.schild > 0:
        sp.schild -= dt
    sp.feuer -= dt

    # Bewegung
    if sp.dash > 0:
        sp.dash -= dt
        sp.vx = sp.dashdx * 950.0
        sp.vy = sp.dashdy * 950.0
        funken(sp.x, sp.y, (150, 250, 255), 2, 60, 0.35)
    else:
        sp.vx += ix * 3000.0 * dt
        sp.vy += iy * 3000.0 * dt
        f = max(0.0, 1.0 - 9.0 * dt)
        sp.vx *= f
        sp.vy *= f
        v = sqrt(sp.vx * sp.vx + sp.vy * sp.vy)
        if v > 340.0:
            sp.vx = sp.vx / v * 340.0
            sp.vy = sp.vy / v * 340.0
        if v > 80.0 and random() < 0.7:
            S.partikel.append([sp.x - sp.vx * 0.04, sp.y - sp.vy * 0.04,
                               -sp.vx * 0.2 + uniform(-30, 30), -sp.vy * 0.2 + uniform(-30, 30),
                               0.3, 0.3, 60, 200, 255])
    sp.x += sp.vx * dt
    sp.y += sp.vy * dt
    sp.x = max(16.0, min(W - 16.0, sp.x))
    sp.y = max(16.0, min(H - 16.0, sp.y))

    # Blickrichtung
    if zielt:
        ziel = atan2(ay, ax)
    elif il > 0:
        ziel = atan2(iy, ix)
    else:
        ziel = sp.winkel
    diff = ziel - sp.winkel
    while diff > pi:
        diff -= 2.0 * pi
    while diff < -pi:
        diff += 2.0 * pi
    schritt = 16.0 * dt
    if diff > schritt:
        diff = schritt
    elif diff < -schritt:
        diff = -schritt
    sp.winkel += diff

    # Schiessen
    if zielt and sp.feuer <= 0 and sp.dash <= 0 and len(S.kugeln) < 140:
        rate = 0.13
        if sp.rapid > 0:
            rate = 0.065
        sp.feuer = rate
        basis = atan2(ay, ax)
        winkel = [basis]
        if sp.triple > 0:
            winkel = [basis - 0.2, basis, basis + 0.2]
        for w in winkel:
            w2 = w + uniform(-0.03, 0.03)
            S.kugeln.append([sp.x + cos(w2) * 16, sp.y + sin(w2) * 16,
                             cos(w2) * 760.0, sin(w2) * 760.0, 0.9])
        funken(sp.x + cos(basis) * 18, sp.y + sin(basis) * 18, (200, 255, 255), 2, 120, 0.2)


# ---------------------------------------------------------------
#  Gegner-KI
# ---------------------------------------------------------------
def bossUpdate(f, dt):
    sp = S.spieler
    f.t += dt
    frac = f.hp / float(f.maxhp)
    if frac > 0.66:
        ph = 0
    elif frac > 0.33:
        ph = 1
    else:
        ph = 2
    if ph != f.phase:
        f.phase = ph
        S.feindkugeln = []
        ring(f.x, f.y, 420, WEISS, 0.7)
        shake(10)
        S.blitz = 0.3
        S.bannertext = "PHASE " + str(ph + 1)
        S.bannerzeit = 1.4
        f.zeit = 1.0
    if ph < 2:
        tx = W / 2.0 + cos(f.t * 0.5) * 230.0
        ty = 190.0 + sin(f.t * 0.8) * 90.0
        v = 90.0
    else:
        tx = sp.x
        ty = sp.y
        v = 75.0
    dx = tx - f.x
    dy = ty - f.y
    d = sqrt(dx * dx + dy * dy) + 0.001
    s = min(d, v)
    f.x += dx / d * s * dt
    f.y += dy / d * s * dt

    f.zeit -= dt
    if ph == 0:
        if f.zeit <= 0:
            f.zeit = 2.0
            n = 16
            off = f.zustand * pi / n
            f.zustand = 1 - f.zustand
            for i in range(n):
                feindschuss(f.x, f.y, off + 2.0 * pi * i / n, 190)
    elif ph == 1:
        f.winkel += dt * 2.2
        if f.zeit <= 0:
            f.zeit = 0.11
            for arm in range(3):
                feindschuss(f.x, f.y, f.winkel + arm * 2.0 * pi / 3.0, 200)
    else:
        f.winkel += dt * 2.8
        if f.zeit <= 0:
            f.zeit = 0.15
            for arm in range(2):
                feindschuss(f.x, f.y, f.winkel + arm * pi, 220)
        f.t2 -= dt
        if f.t2 <= 0:
            f.t2 = 2.4
            w = atan2(sp.y - f.y, sp.x - f.x)
            for i in range(5):
                feindschuss(f.x, f.y, w + (i - 2) * 0.18, 260)
            for i in range(2):
                S.neu.append(Feind("chaser", f.x + uniform(-40, 40), f.y + uniform(-40, 40)))


def feindUpdate(f, dt):
    sp = S.spieler
    f.t += dt
    if f.blitz > 0:
        f.blitz -= dt
    typ = f.typ
    if typ == "boss":
        bossUpdate(f, dt)
        return
    dx = sp.x - f.x
    dy = sp.y - f.y
    d = sqrt(dx * dx + dy * dy) + 0.001
    w = atan2(dy, dx)
    k = min(1.0, 4.0 * dt)

    if typ == "chaser" or typ == "mini" or typ == "splitter":
        if typ == "splitter":
            w = w + sin(f.t * 1.5) * 0.2
            f.winkel += dt * 2.0
        else:
            w = w + sin(f.t * 3.0) * 0.45
            f.winkel += dt * 3.0
        f.vx += (cos(w) * f.speed - f.vx) * k
        f.vy += (sin(w) * f.speed - f.vy) * k
        f.x += f.vx * dt
        f.y += f.vy * dt

    elif typ == "shooter":
        f.winkel += dt
        if d > 300:
            mx = cos(w)
            my = sin(w)
        elif d < 200:
            mx = -cos(w)
            my = -sin(w)
        else:
            mx = -sin(w) * f.zustand
            my = cos(w) * f.zustand
        f.t2 -= dt
        if f.t2 <= 0:
            f.zustand = -f.zustand
            f.t2 = uniform(2.0, 4.0)
        f.vx += (mx * f.speed - f.vx) * k
        f.vy += (my * f.speed - f.vy) * k
        f.x += f.vx * dt
        f.y += f.vy * dt
        f.zeit -= dt
        if f.zeit < 0.3 and f.zeit > 0:
            f.blitz = 0.05
        if f.zeit <= 0:
            f.zeit = max(0.9, 2.2 - 0.05 * S.welle) + uniform(0.0, 0.4)
            n = 1
            if S.welle >= 6:
                n = 3
            if S.welle >= 11:
                n = 5
            for i in range(n):
                off = (i - (n - 1) / 2.0) * 0.22
                feindschuss(f.x, f.y, w + off, 235)

    elif typ == "tank":
        f.winkel += dt * 1.2
        f.x += cos(w) * f.speed * dt
        f.y += sin(w) * f.speed * dt
        f.zeit -= dt
        if f.zeit <= 0:
            f.zeit = 3.5
            n = 8
            if S.welle >= 9:
                n = 12
            for i in range(n):
                feindschuss(f.x, f.y, f.winkel + 2.0 * pi * i / n, 170)

    elif typ == "dart":
        if f.zustand == 0:
            f.winkel = w
            f.x += cos(w) * f.speed * dt
            f.y += sin(w) * f.speed * dt
            f.zeit -= dt
            if f.zeit <= 0:
                f.zustand = 1
                f.zeit = 0.7
        elif f.zustand == 1:
            f.zeit -= dt
            if f.zeit > 0.3:
                f.winkel = w
            f.blitz = 0.05
            if f.zeit <= 0:
                f.zustand = 2
                f.zeit = 0.75
        elif f.zustand == 2:
            f.zeit -= dt
            f.x += cos(f.winkel) * 600.0 * dt
            f.y += sin(f.winkel) * 600.0 * dt
            funken(f.x, f.y, f.farbe, 1, 40, 0.3)
            if f.x < 6 or f.x > W - 6 or f.y < 6 or f.y > H - 6:
                f.zeit = 0
                funken(f.x, f.y, f.farbe, 8, 200, 0.4)
            if f.zeit <= 0:
                f.zustand = 3
                f.zeit = 0.8
        else:
            f.winkel = w
            f.zeit -= dt
            if f.zeit <= 0:
                f.zustand = 0
                f.zeit = uniform(0.8, 1.5)

    f.x = max(4.0, min(W - 4.0, f.x))
    f.y = max(4.0, min(H - 4.0, f.y))


