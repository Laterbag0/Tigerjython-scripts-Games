def zeichneHintergrund(bg):
    bg.clear(Color(7, 7, 18))
    for s in S.sterne:
        bg.setPaintColor(Color(150, 170, 255, cl(s[3])))
        bg.fillRectangle(Point(int(s[0]), int(s[1])), Point(int(s[0]) + 2, int(s[1]) + 2))
    gc = GRIDFARBEN[(S.welle - 1) % len(GRIDFARBEN)]
    bg.setLineWidth(1)
    bg.setPaintColor(Color(gc[0], gc[1], gc[2], cl(55 + S.puls * 130)))
    for x in range(0, W + 1, 40):
        bg.drawLine(P(x, 0), P(x, H))
    for y in range(0, H + 1, 40):
        bg.drawLine(P(0, y), P(W, y))
    bg.setLineWidth(3)
    bg.setPaintColor(Color(60, 240, 255, 110))
    bg.drawLine(P(2, 2), P(W - 2, 2))
    bg.drawLine(P(W - 2, 2), P(W - 2, H - 2))
    bg.drawLine(P(W - 2, H - 2), P(2, H - 2))
    bg.drawLine(P(2, H - 2), P(2, 2))


def zeichneFeind(bg, f):
    col = f.farbe
    if f.blitz > 0:
        col = WEISS
    r = f.r
    typ = f.typ
    if typ == "boss":
        bcols = [(255, 90, 90), (255, 170, 50), (255, 60, 255)]
        if f.blitz <= 0:
            col = bcols[f.phase]
        glut(bg, f.x, f.y, r * 2.0, col, 35)
        glut(bg, f.x, f.y, r * 1.4, col, 30)
        vieleck(bg, f.x, f.y, 12, r, f.t * 0.4, col, 3)
        vieleck(bg, f.x, f.y, 6, r * 0.65, -f.t * 0.9, col, 2)
        for i in range(4):
            w = f.t * 1.5 + i * pi / 2.0
            glut(bg, f.x + cos(w) * r, f.y + sin(w) * r, 7, col, 200)
        pulse = 0.5 + 0.5 * sin(f.t * 5.0)
        glut(bg, f.x, f.y, 8 + pulse * 6, WEISS, 200)
        return
    glut(bg, f.x, f.y, r * 1.8, col, 40)
    if typ == "dart":
        if f.zustand == 1:
            bg.setLineWidth(2)
            bg.setPaintColor(Color(255, 240, 60, 90 + int(60 * sin(S.zeit * 40.0) + 60)))
            bg.drawLine(P(f.x, f.y), P(f.x + cos(f.winkel) * 900.0, f.y + sin(f.winkel) * 900.0))
        vieleck(bg, f.x, f.y, 3, r * 1.3, f.winkel, col, 2)
        return
    vieleck(bg, f.x, f.y, f.seiten, r, f.winkel, col, 2)
    if f.maxhp > 1:
        anteil = f.hp / float(f.maxhp)
        vieleck(bg, f.x, f.y, f.seiten, r * (0.2 + 0.55 * anteil), -f.winkel, col, 2, 200)


def zeichneSpieler(bg):
    sp = S.spieler
    if sp.unverw > 0 and sp.dash <= 0:
        if int(S.zeit * 18.0) % 2 == 0:
            return
    col = CYAN
    if sp.dash > 0:
        col = WEISS
    glut(bg, sp.x, sp.y, 26, col, 35)
    glut(bg, sp.x, sp.y, 17, col, 35)
    w = sp.winkel
    nase = P(sp.x + cos(w) * 18, sp.y + sin(w) * 18)
    links = P(sp.x + cos(w + 2.5) * 15, sp.y + sin(w + 2.5) * 15)
    hinten = P(sp.x + cos(w + pi) * 7, sp.y + sin(w + pi) * 7)
    rechts = P(sp.x + cos(w - 2.5) * 15, sp.y + sin(w - 2.5) * 15)
    bg.setLineWidth(2)
    bg.setPaintColor(Color(col[0], col[1], col[2], 255))
    bg.drawLine(nase, links)
    bg.drawLine(links, hinten)
    bg.drawLine(hinten, rechts)
    bg.drawLine(rechts, nase)
    if sp.schild > 0:
        if sp.schild > 2.0 or int(S.zeit * 12.0) % 2 == 0:
            bg.setLineWidth(3)
            bg.setPaintColor(Color(90, 150, 255, cl(150 + 80 * sin(S.zeit * 8.0))))
            bg.drawCircle(P(sp.x, sp.y), 25)


def zeichneWelt(bg):
    # Ringe
    bg.setLineWidth(3)
    for r in S.ringe:
        anteil = r[3] / r[4]
        radius = r[2] * (1.0 - anteil * anteil)
        c = r[5]
        bg.setPaintColor(Color(c[0], c[1], c[2], cl(anteil * 220)))
        bg.drawCircle(P(r[0], r[1]), int(radius))
    # Items
    for it in S.items:
        if it[4] < 3.0 and int(S.zeit * 10.0) % 2 == 0:
            continue
        col = ITEMFARBE[it[2]]
        pulse = 1.0 + 0.15 * sin(S.zeit * 6.0 + it[0])
        glut(bg, it[0], it[1], 24 * pulse, col, 45)
        vieleck(bg, it[0], it[1], 6, 14 * pulse, S.zeit * 2.0, col, 2)
        text(bg, ITEMZEICHEN[it[2]], it[0], it[1] + 6, 18, col, 255, True, True)
    # Spawn-Marker
    for m in S.marker:
        anteil = m[3] / m[4]
        col = DATEN[m[2]][3]
        gr = 30.0
        if m[2] == "boss":
            gr = 75.0
        rr = gr * (0.4 + anteil * 0.9)
        bg.setLineWidth(2)
        bg.setPaintColor(Color(col[0], col[1], col[2], cl(110 + 110 * (1.0 - anteil))))
        bg.drawCircle(P(m[0], m[1]), int(rr))
        vieleck(bg, m[0], m[1], 4, gr * 0.3, S.zeit * 6.0, col, 2, 200)
    # Feinde
    for f in S.feinde:
        if not f.tot:
            zeichneFeind(bg, f)
    # Spielerkugeln
    bg.setLineWidth(3)
    for k in S.kugeln:
        bg.setPaintColor(Color(200, 255, 255, 255))
        bg.drawLine(P(k[0], k[1]), P(k[0] - k[2] * 0.025, k[1] - k[3] * 0.025))
        glut(bg, k[0], k[1], 7, CYAN, 55)
    # Feindkugeln
    viele = len(S.feindkugeln) > 120
    for k in S.feindkugeln:
        if not viele:
            glut(bg, k[0], k[1], 10, (255, 60, 200), 60)
        glut(bg, k[0], k[1], 5, (255, 80, 210), 255)
        glut(bg, k[0], k[1], 2, (255, 230, 250), 255)
    # Spieler
    if S.zustand != "tot":
        zeichneSpieler(bg)
    # Partikel
    bg.setLineWidth(2)
    for p in S.partikel:
        a = p[4] / p[5] * 255.0
        bg.setPaintColor(Color(p[6], p[7], p[8], cl(a)))
        bg.drawLine(P(p[0], p[1]), P(p[0] - p[2] * 0.04, p[1] - p[3] * 0.04))
    # Texte
    for t in S.texte:
        text(bg, t[2], t[0], t[1], 16, t[4], t[3] * 255.0, True, True)


