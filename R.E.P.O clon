def ereignis(c):
    z = S.zustand
    if z == "boot":
        if not bootFertig():
            if c == 10 or c == 32:
                S.bootstart = S.bootstart - 100.0
        else:
            if c == 38 or c == 87:
                S.menu = (S.menu - 1) % 3
            elif c == 40 or c == 83:
                S.menu = (S.menu + 1) % 3
            elif c == 10 or c == 32:
                menuWahl()
    elif z == "intro":
        if c == 10 or c == 32:
            S.zustand = "spiel"
            teufel("Hallo. Ich habe auf dich gewartet.", 6.0)
    elif z == "spiel":
        if c == 69:
            benutzen()
        elif c == 80 or c == 27:
            S.zustand = "pause"
    elif z == "pause":
        if c == 80 or c == 27 or c == 10:
            S.zustand = "spiel"
    elif z == "lesen":
        if c == 69 or c == 27 or c == 10 or c == 32:
            S.zustand = "spiel"
    elif z == "puzzle":
        puzzleEreignis(c)
    elif z == "name":
        nameEreignis(c)
    elif z == "tot":
        if S.totzeit > 2.6 and (c == 10 or c == 32):
