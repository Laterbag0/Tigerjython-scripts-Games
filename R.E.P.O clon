def simuliere(ci, si):
    leben = 3
    n = 0
    while n < 50:
        if ci == 0:
            ok = leben < 0
        elif ci == 1:
            ok = leben > 0
        elif ci == 2:
            ok = leben >= 0
        else:
            ok = leben == 3
        if not ok:
            break
        n += 1
        if si == 0:
            leben = leben + 1
        elif si == 1:
            leben = leben - 1
        elif si == 2:
            leben = leben - 2
        else:
            leben = leben * 2
    return n


