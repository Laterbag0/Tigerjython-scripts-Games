def neuesPatrouillenZiel(m):
    sp = S.sp
    if random() < 0.4:
        best = None
        for rm in RAUMMITTEN:
            d = (rm[0] - sp.x) ** 2 + (rm[1] - sp.y) ** 2
            if best is None or d < best[0]:
                best = (d, rm)
        ziel = best[1]
    else:
        ziel = choice(RAUMMITTEN)
    m.zx = ziel[0]
    m.zy = ziel[1]


def monsterBewegen(m, v, dt):
    ax = m.zx - m.x
    ay = m.zy - m.y
    if sqrt(ax * ax + ay * ay) < 0.35:
        return True
    m.pfadzeit -= dt
    if m.pfadzeit <= 0:
        m.pfadzeit = 0.3
        p = pfadSchritt(m.x, m.y, m.zx, m.zy)
        if p is None:
            return True
        m.wx = p[0]
        m.wy = p[1]
    ex = m.wx - m.x
    ey = m.wy - m.y
    e = sqrt(ex * ex + ey * ey)
    if e > 0.001:
        s = min(e, v * dt)
        m.x += ex / e * s
        m.y += ey / e * s
    return False


def monsterUpdate(dt):
    m = S.mon
    sp = S.sp
    m.t += dt
    dx = sp.x - m.x
    dy = sp.y - m.y
    d = sqrt(dx * dx + dy * dy)
    S.gefahr = max(0.0, 1.0 - d / 10.0)
    weite = 9.0
    if sp.augen < 0.42:
        weite = 5.0
    sieht = d < weite and sicht(m.x, m.y, sp.x, sp.y)
    if sieht:
        if m.modus != "jagd":
            m.modus = "jagd"
            S.glitch = 0.5
            S.jagdgemeldet += 1
            if S.jagdgemeldet == 1:
                teufel("LAUF!", 3.0)
            else:
                teufel(choice(["Er hat dich.", "Hinter dir.", "Du bist so laut.", "Zu spaet."]), 3.0)
        m.verloren = 0.0
        m.zx = sp.x
        m.zy = sp.y
    else:
        if m.modus == "jagd":
            m.verloren += dt
            if m.verloren > 4.0:
                m.modus = "suche"
                m.warte = 0.0
        elif S.laerm == 2 and d < 10.0:
            m.modus = "suche"
            m.zx = sp.x
            m.zy = sp.y
        elif S.laerm == 1 and d < 2.8:
            m.modus = "suche"
            m.zx = sp.x
            m.zy = sp.y
    if m.modus == "patrouille":
        if m.warte > 0:
            m.warte -= dt
        else:
            if monsterBewegen(m, 1.5 + m.bonus, dt):
                m.warte = uniform(1.0, 2.5)
                neuesPatrouillenZiel(m)
    elif m.modus == "suche":
        if monsterBewegen(m, 2.1 + m.bonus, dt):
            m.warte += dt
            if m.warte > 2.0:
                m.modus = "patrouille"
                m.warte = 0.0
                neuesPatrouillenZiel(m)
    else:
        v = 2.6 + m.bonus
        if sieht and d < 6.0:
            if d > 0.01:
                m.x += dx / d * v * dt
                m.y += dy / d * v * dt
        else:
            monsterBewegen(m, v, dt)
    if d < 0.6:
        gefangen()


