def cl(v):
    if v < 0:
        return 0
    if v > 255:
        return 255
    return int(v)


def font(g):
    if g not in FONTS:
        FONTS[g] = Font("Monospaced", Font.BOLD, g)
    return FONTS[g]


def text(bg, s, x, y, groesse, col, a=255, mitte=False):
    if len(s) == 0:
        return
    bg.setFont(font(groesse))
    bg.setPaintColor(Color(cl(col[0]), cl(col[1]), cl(col[2]), cl(a)))
    if mitte:
        x = x - len(s) * groesse * 0.6 / 2.0
    bg.drawText(s, Point(int(x), int(y)))


def rechteck(bg, x0, y0, x1, y1, col, a=255):
    ax = int(min(x0, x1))
    bx = int(max(x0, x1))
    ay = int(min(y0, y1))
    by = int(max(y0, y1))
    bg.setPaintColor(Color(cl(col[0]), cl(col[1]), cl(col[2]), cl(a)))
    bg.fillRectangle(Point(ax, ay), Point(bx, by))


def kreis(bg, x, y, r, col, a=255):
    bg.setPaintColor(Color(cl(col[0]), cl(col[1]), cl(col[2]), cl(a)))
    bg.fillCircle(Point(int(x), int(y)), int(max(0, r)))


def linie(bg, x0, y0, x1, y1, col, breite, a=255):
    bg.setLineWidth(int(breite))
    bg.setPaintColor(Color(cl(col[0]), cl(col[1]), cl(col[2]), cl(a)))
    bg.drawLine(Point(int(x0), int(y0)), Point(int(x1), int(y1)))


