def spielerUpdate(dt):
    sp = S.sp
    if down(37):
        sp.w -= 2.2 * dt
    if down(39):
        sp.w += 2.2 * dt
    dx = cos(sp.w)
    dy = sin(sp.w)
    ducken = down(67)
    sp.ducken = ducken
    ziel = 0.5
    if ducken:
        ziel = 0.34
    sp.augen += (ziel - sp.augen) * min(1.0, 8.0 * dt)
    vor = 0.0
    seit = 0.0
    if down(87) or down(38):
        vor += 1.0
    if down(83) or down(40):
        vor -= 1.0
    if down(65):
        seit -= 1.0
    if down(68):
        seit += 1.0
    bewegt = vor != 0.0 or seit != 0.0
    rennen = bewegt and down(16) and not ducken and not sp.erschoepft and sp.stamina > 0
    v = 2.3
    if ducken:
        v = 1.2
    if rennen:
        v = 3.9
        sp.stamina -= 30.0 * dt
        if sp.stamina <= 0:
            sp.stamina = 0.0
            sp.erschoepft = True
    else:
        sp.stamina = min(100.0, sp.stamina + 18.0 * dt)
        if sp.erschoepft and sp.stamina > 25.0:
            sp.erschoepft = False
    S.laerm = 0
    if bewegt:
        S.laerm = 1
        if rennen:
            S.laerm = 2
        if ducken:
            S.laerm = 0
        n = sqrt(vor * vor + seit * seit)
        vx = (dx * vor - dy * seit) / n * v * dt
        vy = (dy * vor + dx * seit) / n * v * dt
        if frei(sp.x + vx, sp.y, 0.22):
            sp.x += vx
        if frei(sp.x, sp.y + vy, 0.22):
            sp.y += vy
        sp.schritt += v * dt
        amp = 2.5
        if rennen:
            amp = 5.0
        S.bob = sin(sp.schritt * 3.0) * amp
    else:
        S.bob *= max(0.0, 1.0 - 8.0 * dt)
    # Tuer
    if S.tuerauf and int(sp.x) == EXITX and int(sp.y) == EXITY:
        S.zustand = "name"
        S.nameeingabe = ""
        S.nameversuche = 0
        S.namemsg = "Die Tuer fragt: Wer bist du?"
        S.namestart = S.zeit
    # Naechstes Objekt in Blickrichtung
    S.nah = None
    best = 1.6
    for o in S.objekte:
        ox = o[1] - sp.x
        oy = o[2] - sp.y
        d = sqrt(ox * ox + oy * oy)
        if d < best and d > 0.01:
            if (ox * dx + oy * dy) / d > 0.5:
                best = d
                S.nah = o


