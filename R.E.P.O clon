def tile(ix, iy):
    if ix < 0 or iy < 0 or ix >= MW or iy >= MH:
        return "#"
    return KARTE[iy][ix]


def solid(ix, iy):
    t = tile(ix, iy)
    if t == "#":
        return True
    if t == "X":
        return not S.tuerauf
    return False


def frei(x, y, r):
    for ox in (-r, r):
        for oy in (-r, r):
            if solid(int(x + ox), int(y + oy)):
                return False
    for o in S.objekte:
        if o[0] == "term":
            dx = x - o[1]
            dy = y - o[2]
            if dx * dx + dy * dy < 0.32 * 0.32:
                return False
    return True


def sicht(x0, y0, x1, y1):
    dx = x1 - x0
    dy = y1 - y0
    d = sqrt(dx * dx + dy * dy)
    if d < 0.01:
        return True
    n = int(d / 0.15)
    for i in range(1, n):
        t = i * 0.15 / d
        if tile(int(x0 + dx * t), int(y0 + dy * t)) != ".":
            return False
    return True


def pfadSchritt(sx, sy, tx, ty):
    a = (int(sx), int(sy))
    b = (int(tx), int(ty))
    if a == b:
        return tx, ty
    vor = {a: None}
    queue = [a]
    qi = 0
    while qi < len(queue):
        c = queue[qi]
        qi += 1
        if c == b:
            break
        for d in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            n = (c[0] + d[0], c[1] + d[1])
            if n not in vor and tile(n[0], n[1]) == ".":
                vor[n] = c
                queue.append(n)
    if b not in vor:
        return None
    c = b
    while vor[c] is not None and vor[c] != a:
        c = vor[c]
    return c[0] + 0.5, c[1] + 0.5


