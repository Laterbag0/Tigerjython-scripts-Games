def streifen(bg, art, obj, tx, ty):
    scr = int(W / 2.0 * (1.0 + tx / ty))
    size = int(H / ty)
    if size < 2:
        return
    bodenY = int(H / 2.0 + S.bob + size * S.sp.augen)
    if art == "m":
        hoehe = size * 1.1
        breite = int(size * 0.8)
    elif obj[0] == "term":
        hoehe = size * 0.8
        breite = int(size * 0.7)
    else:
        hoehe = size * 0.9
        breite = int(size * 0.5)
    if breite < 2:
        return
    sw = STEP
    if size > 260:
        sw = 6
    oben = bodenY - int(hoehe)
    start = scr - breite // 2
    ende = min(start + breite, W)
    xx = start
    if xx < 0:
        xx = xx + ((0 - xx) // STEP) * STEP
    while xx < ende:
        c = xx // STEP
        if c >= 0 and c < N and ty < zbuf[c]:
            u = (xx - start) / float(breite)
            li = lichtAt(ty, 2.0 * xx / W - 1.0)
            for seg in segmente(art, obj, u):
                f = li
                if seg[3]:
                    f = max(li, 0.5 * max(0.2, 1.0 - ty / 12.0))
                col = seg[2]
