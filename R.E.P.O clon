def lichtUpdate(dt):
    S.flackerzeit -= dt
    if S.flackerzeit <= 0:
        f = 1.0
        if S.gefahr > 0.5:
            f = 0.4
        S.flackerzeit = uniform(3.0, 9.0) * f
        S.flackerdauer = uniform(0.15, 0.6)
    if S.dunkel > 0:
        S.dunkel -= dt
        S.licht = 0.03
    elif S.flackerdauer > 0:
        S.flackerdauer -= dt
        S.licht = uniform(0.1, 1.0)
    else:
        S.licht = 0.95 + random() * 0.05


def effekteUpdate(dt):
    if S.glitch > 0:
        S.glitch -= dt
    if S.shake > 0:
        S.shake = max(0.0, S.shake - 20.0 * dt)


def hinweisCheck():
    if not S.hinweis and S.spielzeit > 75.0 and S.geloest.count(True) == 0:
        S.hinweis = True
        teufel("Suche die leuchtenden Terminals.", 6.0)


