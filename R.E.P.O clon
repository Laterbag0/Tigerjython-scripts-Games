        return
    p = S.puz
    if p == 0:
        if c == 37 and S.lopos % 3 > 0:
            S.lopos -= 1
        elif c == 39 and S.lopos % 3 < 2:
            S.lopos += 1
        elif c == 38 and S.lopos >= 3:
            S.lopos -= 3
        elif c == 40 and S.lopos < 6:
            S.lopos += 3
        elif c == 10 or c == 32:
            druecke(S.lo, S.lopos)
            if S.lo.count(True) == 9:
                S.puzmsg = "Alle Seelen leuchten. Wie ... laestig."
                puzzleGeloest()
    elif p == 1:
        ziffer = -1
        if c >= 48 and c <= 57:
            ziffer = c - 48
        elif c >= 96 and c <= 105:
            ziffer = c - 96
        if ziffer >= 0 and len(S.eingabe) < 4:
            S.eingabe = S.eingabe + str(ziffer)
        elif c == 8 and len(S.eingabe) > 0:
            S.eingabe = S.eingabe[:-1]
        elif c == 10 and len(S.eingabe) == 4:
            richtig = ""
            for d in S.code:
                richtig = richtig + str(d)
            if S.eingabe == richtig:
                S.puzmsg = "Korrekt. Ich hasse dich."
                puzzleGeloest()
            else:
                S.versuche += 1
                S.eingabe = ""
                S.puzfehler = 1.0
                S.glitch = 0.6
                alarmiere()
                S.puzmsg = "FALSCH. Das hat er gehoert."
                teufel("FALSCH.", 4.0)
    else:
        if c == 38 or c == 40:
            S.fixzeile = 1 - S.fixzeile
        elif c == 37:
            S.fix[S.fixzeile] = (S.fix[S.fixzeile] - 1) % 4
        elif c == 39:
            S.fix[S.fixzeile] = (S.fix[S.fixzeile] + 1) % 4
        elif c == 10 or c == 32:
            n = simuliere(S.fix[0], S.fix[1])
            if n == 3 and S.fix == [1, 1]:
                S.puzmsg = "Das Monster jagt genau 3 Mal. Die Tuer geht auf."
                puzzleGeloest()
            elif n >= 50:
                S.puzmsg = "ENDLOSSCHLEIFE! Alles friert ein..."
                S.puzfehler = 1.5
                S.glitch = 1.5
                alarmiere()
                teufel("Endlosschleife. Das war laut.", 4.0)
            else:
                S.puzmsg = "Das Monster jagt " + str(n) + " Mal. Es sollten 3 sein."


