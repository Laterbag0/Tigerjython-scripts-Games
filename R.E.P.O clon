def taste(e):
    c = e.getKeyCode()
    neu = c not in gehalten
    gehalten[c] = 0
    if neu:
        EREIGNISSE.append(c)


def los(e):
    gehalten[e.getKeyCode()] = System.currentTimeMillis()


def aufraeumen():
    jetzt = System.currentTimeMillis()
    for c in list(gehalten.keys()):
        t = gehalten.get(c, 0)
        if t != 0 and jetzt - t > 70:
            gehalten.pop(c, None)


def down(c):
    return c in gehalten


