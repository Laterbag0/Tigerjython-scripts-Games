    x = i % 3
    y = i // 3
    for c in ((x, y), (x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
        if c[0] >= 0 and c[0] < 3 and c[1] >= 0 and c[1] < 3:
            k = c[1] * 3 + c[0]
            lo[k] = not lo[k]


