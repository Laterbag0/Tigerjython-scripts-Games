def lichtAt(d, kam):
    cone = 1.0 - abs(kam) / 0.7
    if cone < 0:
        cone = 0.0
    weite = 2.6 + 8.0 * cone
    li = 1.0 - d / weite
    if li < 0:
        li = 0.0
    li = li * li
    li = li * (0.25 + 0.75 * cone) + 0.045
    nah = 1.0 - d / 1.6
    if nah > 0:
        li += nah * 0.25
    li = li * S.licht
    if li > 1.0:
        li = 1.0
    return li


def projiziere(x, y):
    sp = S.sp
    dx = cos(sp.w)
    dy = sin(sp.w)
    plx = -dy * FOV
    ply = dx * FOV
    sx = x - sp.x
    sy = y - sp.y
    inv = 1.0 / (plx * dy - dx * ply)
    tx = inv * (dy * sx - dx * sy)
    ty = inv * (-ply * sx + plx * sy)
    return tx, ty


def zeichne3D(bg):
    sp = S.sp
    dx = cos(sp.w)
    dy = sin(sp.w)
    plx = -dy * FOV
    ply = dx * FOV
    px = sp.x
    py = sp.y
    eye = sp.augen
    hor = int(H / 2.0 + S.bob)
    lf = 0.5 + 0.5 * S.licht
    for i in range(6):
        y0 = int(hor * i / 6.0)
        y1 = int(hor * (i + 1) / 6.0)
        b = int((5 + 9 * (i / 6.0)) * lf)
        rechteck(bg, 0, y0, W, y1 + 1, (b, b, b + 4))
    for i in range(8):
        y0 = hor + int((H - hor) * i / 8.0)
        y1 = hor + int((H - hor) * (i + 1) / 8.0)
        b = int((7 + 24 * (i / 8.0)) * (0.4 + 0.6 * S.licht))
        rechteck(bg, 0, y0, W, y1 + 1, (b, b + 1, b))
    kreis(bg, W // 2, H + 80, 260, (255, 240, 200), 16 * S.licht)

    chase = S.mon.modus == "jagd"
    for col in range(N):
        kam = 2.0 * col / N - 1.0
        rx = dx + plx * kam
        ry = dy + ply * kam
        mx = int(px)
        my = int(py)
        if rx != 0:
            ddx = abs(1.0 / rx)
        else:
            ddx = 1e30
        if ry != 0:
            ddy = abs(1.0 / ry)
        else:
            ddy = 1e30
        if rx < 0:
            sx = -1
            sdx = (px - mx) * ddx
        else:
            sx = 1
            sdx = (mx + 1.0 - px) * ddx
        if ry < 0:
            sy = -1
            sdy = (py - my) * ddy
        else:
            sy = 1
            sdy = (my + 1.0 - py) * ddy
        seite = 0
        zaehler = 0
        t = "#"
        while True:
            if sdx < sdy:
                sdx += ddx
                mx += sx
                seite = 0
            else:
                sdy += ddy
                my += sy
                seite = 1
            zaehler += 1
            t = tile(mx, my)
            if t == "#" or t == "X" or zaehler > 60:
                break
        if seite == 0:
            d = sdx - ddx
            wx = py + d * ry
        else:
            d = sdy - ddy
            wx = px + d * rx
        if d < 0.05:
            d = 0.05
        zbuf[col] = d
        h = int(H / d)
        top = hor - int(h * (1.0 - eye))
        bottom = hor + int(h * eye)
        li = lichtAt(d, kam)
        fr = wx - int(wx)
        blut = False
        if t == "X":
            if fr < 0.10 or fr > 0.90:
                base = (78, 80, 95)
            elif S.tuerauf:
                base = (50, 190, 105)
            else:
                base = (170, 35, 35)
            li = max(li, 0.5 + 0.15 * sin(S.zeit * 4.0))
        else:
            v = (mx * 7 + my * 13) % 11
            if v == 0:
                base = (125, 50, 50)
                blut = True
            elif v < 4:
                base = (88, 95, 112)
            else:
                base = (102, 106, 122)
        f = li
        if seite == 1:
            f = f * 0.8
        r = base[0] * f
        g = base[1] * f
        b = base[2] * f
        if chase:
            r = r * 1.35
            g = g * 0.8
            b = b * 0.8
        x0 = col * STEP
        x1 = x0 + STEP
        yt = max(0, top)
        yb = min(H, bottom)
        rechteck(bg, x0, yt, x1, yb, (r, g, b))
        dunkel = (r * 0.45, g * 0.45, b * 0.45)
        if t == "X":
            if fr >= 0.10 and fr <= 0.90:
                if abs(fr - 0.5) < 0.012:
                    rechteck(bg, x0, yt, x1, yb, dunkel)
                rechteck(bg, x0, top + int(h * 0.10), x1, top + int(h * 0.20), (r * 1.4, g * 1.4, b * 1.4))
                if not S.tuerauf and fr > 0.40 and fr < 0.60:
                    lc = max(li, 0.55)
                    rechteck(bg, x0, top + int(h * 0.45), x1, top + int(h * 0.62), (230 * lc, 190 * lc, 60 * lc))
        elif DETAIL > 0 and d < 7.5:
            zeilen = 5
            for k in range(1, zeilen):
                yy = top + int(h * k / float(zeilen))
                if yy >= 0 and yy < H:
                    rechteck(bg, x0, yy, x1, yy + 1, dunkel)
            for k in range(zeilen):
                off = 0.0
                if k % 2 == 1:
                    off = 0.25
                q = (fr + off) % 0.5
                if q < 0.014 or q > 0.486:
                    y0 = top + int(h * k / float(zeilen))
                    y1 = top + int(h * (k + 1) / float(zeilen))
                    rechteck(bg, x0, max(0, y0), x1, min(H, y1), dunkel)
            if blut and sin(wx * 29.0) > 0.55:
                laenge = 0.12 + 0.4 * abs(sin(wx * 13.0 + 1.0))
                rechteck(bg, x0, top + int(h * 0.08), x1, top + int(h * (0.08 + laenge)), (130 * f, 10 * f, 10 * f))
        rechteck(bg, x0, max(0, bottom - int(h * 0.10)), x1, yb, (r * 0.5, g * 0.5, b * 0.5))
        if t != "X":
            rechteck(bg, x0, yt, x1, max(yt, top + int(h * 0.05)), (r * 0.6, g * 0.6, b * 0.6))


def monsterSegmente(u):
    m = S.mon
    t = m.t
    tempo = 2.5
    if m.modus == "jagd":
        tempo = 7.0
    sw = sin(t * tempo)
    u = u - 0.012 * sin(t * 1.3)
    d = abs(u - 0.5)
    seg = []
    # Arme (lang, mit Krallen)
    for sgn in (-1, 1):
        ax = 0.5 + sgn * (0.265 + 0.012 * sw)
        ex = ax + sgn * 0.012
        if abs(u - ax) < 0.030:
            seg.append((0.23, 0.58, (24, 23, 32), False))
        if abs(u - ex) < 0.022:
            seg.append((0.58, 0.93, (28, 27, 38), False))
        if abs(u - ex) < 0.040:
            seg.append((0.92, 0.99, (150, 145, 135), False))
        for k in (-1, 0, 1):
            if abs(u - (ex + k * 0.026)) < 0.006:
                seg.append((0.99, 1.06, (170, 165, 150), False))
    # Beine
    for sgn in (-1, 1):
        lx = 0.5 + sgn * 0.075 + 0.018 * sw * sgn
        if abs(u - lx) < 0.022:
            seg.append((0.78, 0.99, (42, 40, 50), False))
        if abs(u - lx) < 0.040:
            seg.append((0.97, 1.0, (30, 28, 36), False))
    # Zerfetzter Mantel
    if d < 0.20:
        top = 0.20 + d * 0.55
        bot = 0.84 + 0.035 * sin(u * 55.0 + 1.0) + 0.02 * sin(u * 23.0)
        fold = 0.75 + 0.25 * sin(u * 46.0)
        seg.append((top, bot, (40 * fold, 38 * fold, 54 * fold), False))
        if abs(sin(u * 31.0)) < 0.05:
            seg.append((0.34, 0.56, (150, 15, 15), True))
    if d < 0.045:
        seg.append((0.17, 0.24, (30, 28, 36), False))
    # Kopf: Maske mit Kinn, Rissen, Augen, Zaehnen
    a = 0.115
    if d < a:
        q = d / a
        hh = 0.105 * sqrt(1.0 - q * q)
        sh = 1.0 - q * 0.45
        mask = (208 * sh, 200 * sh, 182 * sh)
        seg.append((0.105 - hh, 0.105 + hh, mask, False))
        if d < 0.06:
            seg.append((0.17, 0.17 + 0.075 * (1.0 - d / 0.06), mask, False))
        if abs(u - 0.465) < 0.0035:
            seg.append((0.0, 0.10, (40, 34, 30), False))
        if abs(u - 0.56) < 0.0035:
            seg.append((0.06, 0.15, (40, 34, 30), False))
        fl = 0.8 + 0.2 * sin(t * 9.0)
        for sgn in (-1, 1):
            ex = 0.5 + sgn * 0.047
            if abs(u - ex) < 0.028:
                seg.append((0.075 + abs(u - ex) * 0.5, 0.125, (8, 0, 0), False))
            if abs(u - ex) < 0.016:
                seg.append((0.086, 0.114, (255 * fl, 30, 30), True))
        if d < 0.065:
            seg.append((0.150, 0.174, (6, 0, 0), False))
            if int((u - 0.4) * 170.0) % 2 == 0:
                seg.append((0.144, 0.153, (225, 220, 200), False))
                seg.append((0.171, 0.180, (225, 220, 200), False))
    # Hoerner
    s = (d - 0.06) / 0.14
    if s >= 0.0 and s <= 1.0:
        vc = 0.03 - 0.20 * s * (1.2 - 0.4 * s)
        th = 0.022 * (1.0 - s) + 0.006
        seg.append((vc - th, vc + th, (56, 50, 48), False))
    return seg


